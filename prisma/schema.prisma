generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id             String          @id @default(uuid())
  name           String?
  email          String?         @unique
  image          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  apiKeys        ApiKey[]
  brandKits      BrandKit[]
  socialAccounts SocialAccount[]
  generations    Generation[]
}

model ApiKey {
  id           String   @id @default(uuid())
  userId       String
  provider     String   // "openai" | "anthropic" | "replicate" | "fal"
  encryptedKey String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, provider])
}

model BrandKit {
  id             String   @id @default(uuid())
  userId         String
  brandName      String   @default("My Project")
  primaryColor   String   @default("#3B28CC")
  accentColor    String   @default("#D4FF33")
  fontStyle      String   @default("Inter")
  logoUrl        String?
  toneOfVoice    String   @default("Informative, energetic, technical yet accessible")
  targetAudience String   @default("Open Source Developers & Tech Leaders")
  isDefault      Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SocialAccount {
  id           String   @id @default(uuid())
  userId       String
  platform     String   // "x" | "linkedin" | "discord"
  platformUser String?
  accessToken  String
  refreshToken String?
  expiresAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, platform])
}

model Generation {
  id             String   @id @default(uuid())
  userId         String
  sourceUrl      String?
  sourceType     String   // "github_pr" | "jira" | "text"
  title          String
  rawInput       String
  githubDiff     String?
  status         String   @default("completed") // "draft" | "generating" | "completed"
  generatedPosts String   // JSON string storing x, linkedin, discord posts
  carouselSlides String   // JSON string storing 5 slides details
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
